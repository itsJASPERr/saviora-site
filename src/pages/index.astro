---
import SiteLayout from '../components/SiteLayout.astro';
import Contour from '../components/Contour.astro';
import EditorialFooter from '../components/EditorialFooter.astro';
import EditorialLink from '../components/EditorialLink.astro';
import Ripple from '../components/Ripple.astro';
import { sitePath } from '../site';

const practices = [
  { name: 'Sonido', description: 'Música y sesiones de escucha.', path: 'escucha/' },
  { name: 'Oficio', description: 'Instrumentos y objetos hechos a mano.', path: 'taller/' },
  { name: 'Sistemas', description: 'Herramientas digitales para equipos.', path: 'proyectos/#sistemas' },
  { name: 'Regeneración', description: 'Proyectos con comunidades y territorios.', path: 'proyectos/#regeneracion' },
];
const description = 'Hago música e instrumentos, diseño sistemas digitales y colaboro en proyectos de regeneración.';
---

<SiteLayout page="estudio" title="Saviora Estudio" description={description}>
  <div class="intro">
    <section class="hero" aria-labelledby="lema">
      <img class="hero-photo" src={sitePath('anillos-de-madera.webp')} alt="" width="627" height="627" fetchpriority="high" />
      <div class="frame">
        <div class="hero-copy">
          <h1 id="lema">Lo vivo <span>toma forma.</span></h1>
          <p>{description}</p>
          <EditorialLink href="#practicas">Conocé mi trabajo</EditorialLink>
        </div>
      </div>
    </section>
    <Contour />
    <section class="practices" id="practicas" tabindex="-1" aria-labelledby="practicas-titulo">
      <div class="practices-layout frame">
        <div class="practices-heading">
          <h2 id="practicas-titulo">Cuatro formas <span>de trabajar</span></h2>
          <Ripple />
        </div>
        <div class="practices-list">
          {practices.map(({ name, description, path }) => (
            <section>
              <h3><a href={sitePath(path)}>{name}</a></h3>
              <p>{description}</p>
            </section>
          ))}
        </div>
      </div>
    </section>
  </div>
  <EditorialFooter slot="footer" id="colaboraciones" title="Colaboraciones"
    description="Proyectos compartidos entre sonido, oficio y tecnología." />
</SiteLayout>
